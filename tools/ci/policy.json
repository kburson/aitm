{
  "schema": "aitm.ci-policy/v1",
  "line_floor": 90,
  "package": "aitm-usage",
  "product_root": "src/aitm_usage",
  "helpers": ["tools/ci/python_gate.py", "tools/ci/pytest_evidence.py", "tools/ci/verify_pr.py", "tools/ci/file_checks.py"],
  "required_tests": [
    "packages/aitm-usage/tests/test_install.py::test_backup_and_restore_reject_inherited_acl",
    "packages/aitm-usage/tests/test_install.py::test_restore_fences_publication_until_atomic_swap",
    "packages/aitm-usage/tests/test_ledger.py::test_atomic_cursor_and_revisions",
    "packages/aitm-usage/tests/test_ledger.py::test_writer_refusal_read_snapshot_and_release_on_process_exit",
    "packages/aitm-usage/tests/test_service.py::test_one_shot_status_uses_collecting_subprocess_pid",
    "packages/aitm-usage/tests/test_service_process.py::test_real_service_crash_enrollment_and_private_state"
  ],
  "optional_skips": {
    "packages/aitm-usage/tests/test_install.py::test_backup_refuses_store_through_physical_path_alias": "The host does not expose the matching APFS firmlink path"
  },
  "required_children": ["cli-help", "service-one-shot"],
  "pr_jobs": ["python-base", "python", "quality", "file-checks"],
  "push_jobs": ["python", "quality", "file-checks"]
}
