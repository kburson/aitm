{
  "schema": "aitm.path-map/v1",
  "full_prefixes": [".github/", "tools/ci/"],
  "full_names": [
    ".coveragerc",
    ".pytest.toml",
    ".ruff.toml",
    "conftest.py",
    "coverage.py",
    "pyproject.toml",
    "pytest.ini",
